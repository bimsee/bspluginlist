{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://raw.githubusercontent.com/bimsee/bspluginlist/main/schema.json",
  "title": "BIMSee plugin list",
  "description": "Plugin catalogue read by BIMSee's 插件管理 dialog.",
  "type": "object",
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "updated": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": { "$ref": "#/definitions/plugin" }
    }
  },
  "definitions": {
    "plugin": {
      "type": "object",
      "required": ["id", "name", "author", "version", "appVersion", "releaseNotes"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Za-z0-9._-]+$",
          "description": "Install folder name under <exe>/plugins."
        },
        "name": { "type": "string" },
        "author": { "type": "string" },
        "version": {
          "type": "integer",
          "minimum": 0,
          "description": "Must equal Version: in the package's .plugin file."
        },
        "appVersion": {
          "type": "string",
          "description": "Exact versions and/or minimums, e.g. '2.0.1, 3.0.2, 3.1及以上'."
        },
        "releaseNotes": { "type": "string" },
        "description": { "type": "string" },
        "homepage": { "type": "string" },
        "platforms": {
          "type": "array",
          "items": { "type": "string" }
        },
        "arch": {
          "type": "array",
          "items": { "type": "string" }
        },
        "extensions": {
          "type": "array",
          "items": { "type": "string" }
        },
        "download": {
          "type": "string",
          "description": "Single ZIP URL for all platforms."
        },
        "sha256": { "type": "string" },
        "size": { "type": "integer" },
        "downloads": {
          "type": "array",
          "items": { "$ref": "#/definitions/file" }
        },
        "files": {
          "type": "array",
          "items": { "$ref": "#/definitions/file" },
          "description": "Deprecated name for downloads."
        }
      },
      "anyOf": [
        { "required": ["download"] },
        { "required": ["downloads"] },
        { "required": ["files"] }
      ]
    },
    "file": {
      "type": "object",
      "required": ["url"],
      "properties": {
        "platform": { "type": "string" },
        "arch": { "type": "string" },
        "url": { "type": "string" },
        "sha256": { "type": "string" },
        "size": { "type": "integer" }
      }
    }
  }
}
